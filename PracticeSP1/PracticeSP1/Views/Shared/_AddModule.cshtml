@model List<PracticeSP1.Models.CourseModule>

<table id="ExTable" class="table table-bordered table-striped align-middle">
    <thead class="table-light">
        <tr>
            <th>Module Name</th>
            <th>Duration (hrs)</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < Model.Count; i++)
        {
            <tr>
                <td>
                    <input type="text"
                           name="Modules[@i].ModuleName"
                           value="@Model[i].ModuleName"
                           class="form-control"
                           placeholder="Enter module name" />
                </td>
                <td>
                    <input type="number"
                           name="Modules[@i].Duration"
                           value="@Model[i].Duration"
                           class="form-control"
                           placeholder="Duration in hours" />
                </td>
                <td class="text-center">
                    <button onclick="deleteI(this)" type="button" class="btn btn-sm btn-danger">
                        <i class="bi bi-trash"></i> Remove
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<input type="hidden" id="Hindex" value="@Model.Count" />

<!-- Optional: Bootstrap Icons CDN (for trash icon) -->
