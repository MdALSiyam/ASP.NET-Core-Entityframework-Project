@model dynamic
@{
    ViewData["Title"] = "Aggregate";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8">
        <div class="card shadow-lg border-0">
            <div class="card-header bg-primary text-white">
                <h3 class="mb-0"><i class="bi bi-bar-chart-fill me-2"></i> Summary Info</h3>
            </div>
            <div class="card-body bg-light">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Total Registration Fee:
                        <span class="badge bg-success rounded-pill">@Model.TotalRegistrationFee.ToString("F2")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Average Registration Fee:
                        <span class="badge bg-info text-dark rounded-pill">@Model.AverageRegistrationFee.ToString("F2")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Maximum Registration Fee:
                        <span class="badge bg-warning text-dark rounded-pill">@Model.MaxRegistrationFee.ToString("F2")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Minimum Registration Fee:
                        <span class="badge bg-danger rounded-pill">@Model.MinRegistrationFee.ToString("F2")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Total Enrolled Students:
                        <span class="badge bg-primary rounded-pill">@Model.TotalEnrolledStudents</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Optional: Include Bootstrap Icons CDN if you're using icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
